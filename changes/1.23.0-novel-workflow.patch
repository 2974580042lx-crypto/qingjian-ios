+                throw NovelError.message("记忆条目缺少原句、人物或事实，或包含无效的来源。")
+            }
+        }
+    }
+
+    static func validate(delta: NovelMemoryDelta, chapter: NovelChapter, ledger: NovelCanonSnapshot) throws {
+        try validateShape(delta, chapterID: chapter.id)
+        guard delta.sourceBodyFingerprint == bodyFingerprint(chapter.body), delta.baseLedgerFingerprint == ledger.fingerprint else {
+            throw NovelError.message("正文或前文记忆已改变，请重新提取本章记忆。")
+        }
+        let known = Dictionary(uniqueKeysWithValues: ledger.facts.map { ($0.id, $0) })
+        var keys = Set<String>()
+        for fact in delta.updates {
+            guard chapter.body.contains(fact.evidence), known[fact.id] == nil else {
+                throw NovelError.message("记忆条目“\(fact.subject)·\(fact.predicate)”的原句不在本章正文中，未写入正式记忆。")
+            }
+            if [.fact, .characterState, .characterKnowledge].contains(fact.kind) {
+                let key = slot(fact)
+                guard keys.insert(key).inserted else { throw NovelError.message("同一人物或事实字段有多条相互竞争的更新，请重新整理。") }
+                if let locked = ledger.activeFacts.first(where: { slot($0) == key && $0.locked }) {
+                    throw NovelError.message("“\(locked.subject)·\(locked.predicate)”已由作者锁定；请先核对或解除锁定，再更新。")
+                }
+            }
+        }
+        for id in delta.resolveIDs + delta.expireIDs {
+            guard let fact = known[id], fact.isActive, !fact.locked else { throw NovelError.message("待关闭的事实或伏笔不存在、已关闭或已被作者锁定。") }
+            guard let evidence = delta.removalEvidence[id], !evidence.isEmpty, evidence.count <= 1000,
+                  chapter.body.contains(evidence) else { throw NovelError.message("关闭事实或回收伏笔缺少本章原句，未写入正式记忆。") }
+            if delta.resolveIDs.contains(id), fact.kind != .foreshadow { throw NovelError.message("回收操作只能指向已有的未回收伏笔。") }
+        }
+    }
+
+    private static func slot(_ fact: NovelFact) -> String {
+        [fact.kind.rawValue, fact.subject, fact.predicate].map {
+            $0.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        }.joined(separator: "\u{001F}")
+    }
+
+    private static func applying(_ delta: NovelMemoryDelta, chapter: NovelChapter, chapterNumber: Int,
+                                 to old: NovelCanonSnapshot) throws -> NovelCanonSnapshot {
+        try validate(delta: delta, chapter: chapter, ledger: old)
+        guard delta.updates.allSatisfy({ $0.validFromChapter == chapterNumber }) else {
+            throw NovelError.message("记忆条目的生效章节与正文不符。")
+        }
+        var result = old
+        let removed = Set(delta.resolveIDs + delta.expireIDs)
+        for index in result.facts.indices where removed.contains(result.facts[index].id) {
+            result.facts[index].validUntilChapter = chapterNumber - 1
+        }
+        for fact in delta.updates {
+            if [.fact, .characterState, .characterKnowledge].contains(fact.kind) {
+                for index in result.facts.indices where result.facts[index].isActive && slot(result.facts[index]) == slot(fact) {
+                    result.facts[index].validUntilChapter = chapterNumber - 1
+                }
+            }
+            result.facts.append(fact)
+        }
+        result.throughChapter = chapterNumber
+        result.fingerprint = try fingerprint(result.facts)
+        return result
+    }
+}
