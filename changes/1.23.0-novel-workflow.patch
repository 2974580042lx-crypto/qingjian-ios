+@MainActor
+private struct NovelVersionSheet: View {
+    let projectID: UUID
+    let chapterID: UUID
+    let version: NovelRevision
+    @EnvironmentObject private var novels: NovelStore
+    @Environment(\.dismiss) private var dismiss
+    @State private var restore = false
+
+    var body: some View {
+        NavigationStack {
+            ScrollView {
+                Text(version.body).font(TypeScale.answer).foregroundStyle(Ink.ink).lineSpacing(7)
+                    .textSelection(.enabled).frame(maxWidth: .infinity, alignment: .leading).padding(22)
+            }.background(AppBackground()).navigationTitle("历史正文").navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) { Button("关闭") { dismiss() } }
+                ToolbarItem(placement: .confirmationAction) { Button("恢复这版") { restore = true }.disabled(novels.isGenerating) }
+            }
+            .confirmationDialog("恢复这版正文？", isPresented: $restore, titleVisibility: .visible) {
+                Button("恢复为草稿") {
+                    if novels.restoreVersion(projectID: projectID, chapterID: chapterID, versionID: version.id) { dismiss() }
+                }
+            } message: { Text("当前正文会保留为旧稿。恢复后需要重新审阅和定稿。") }
+            .novelErrorAlert(novels)
+        }.tint(Ink.ink)
+    }
+}
