+                sourceChapterID: chapter.id, sourceBodyFingerprint: bodyFingerprint, evidence: item.evidence,
+                validFromChapter: chapterIndex + 1, validUntilChapter: nil, origin: .extracted, locked: false)
+        }
+        var removalEvidence: [UUID: String] = [:]
+        for item in value.removalEvidence {
+            guard removalEvidence[item.id] == nil else { throw NovelError.message("同一失效或回收记录包含重复证据，请重新提取。") }
