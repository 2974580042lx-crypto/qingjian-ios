+import Foundation
+import CryptoKit
+
+/// The ledger is a deterministic projection of accepted chapter deltas. Model output is
+/// never merged until its quotes, references and source body version have been checked.
+enum NovelMemory {
+    static func bodyFingerprint(_ text: String) -> String {
+        SHA256.hash(data: Data(text.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func fingerprint(_ facts: [NovelFact]) throws -> String {
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+        let data = try encoder.encode(facts.sorted { $0.id.uuidString < $1.id.uuidString })
+        return SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func replay(project: NovelProject, beforeChapterID: UUID? = nil) throws -> NovelCanonSnapshot {
+        var ledger = NovelCanonSnapshot(facts: [], fingerprint: try fingerprint([]))
+        let end = beforeChapterID.flatMap { id in project.chapters.firstIndex { $0.id == id } } ?? project.chapters.count
+        var invalid = false
+        for (offset, chapter) in project.chapters.prefix(end).enumerated() {
+            guard !invalid, chapter.status == .confirmed, !chapter.needsReview,
+                  let delta = chapter.memoryDelta,
+                  delta.sourceBodyFingerprint == bodyFingerprint(chapter.body) else {
+                invalid = true; ledger.invalidatedChapterIDs.append(chapter.id); continue
+            }
+            // A previous author correction changes the base fingerprint. Later memories are
+            // held back until the author reviews their chapter against that corrected history.
+            guard delta.baseLedgerFingerprint == ledger.fingerprint else {
+                invalid = true; ledger.invalidatedChapterIDs.append(chapter.id); continue
+            }
+            ledger = try applying(delta, chapter: chapter, chapterNumber: offset + 1, to: ledger)
+            for correction in project.memoryCorrections ?? [] where correction.sourceChapterID == chapter.id && correction.sourceBodyFingerprint == delta.sourceBodyFingerprint {
+                guard let index = ledger.facts.firstIndex(where: { $0.id == correction.factID }) else { continue }
+                ledger.facts[index].value = correction.value
+                ledger.facts[index].origin = .user
+                ledger.facts[index].locked = correction.locked
+                ledger.facts[index].correctionNote = correction.note
+                if correction.invalidated == true { ledger.facts[index].validUntilChapter = max(0, ledger.facts[index].validFromChapter - 1) }
+            }
+            ledger.fingerprint = try fingerprint(ledger.facts)
+        }
+        return ledger
+    }
+
+    static func validateShape(_ delta: NovelMemoryDelta, chapterID: UUID) throws {
+        guard delta.sourceChapterID == chapterID, delta.sourceBodyFingerprint.count == 64,
+              delta.baseLedgerFingerprint.count == 64, delta.updates.count <= 80,
+              delta.resolveIDs.count <= 80, delta.expireIDs.count <= 80,
+              !delta.summary.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              delta.summary.count <= 20000, delta.characterState.count <= 20000, delta.foreshadowing.count <= 20000,
+              Set(delta.updates.map(\.id)).count == delta.updates.count,
+              Set(delta.resolveIDs).count == delta.resolveIDs.count,
+              Set(delta.expireIDs).count == delta.expireIDs.count,
+              Set(delta.resolveIDs).isDisjoint(with: Set(delta.expireIDs)),
+              delta.removalEvidence.count <= 160 else { throw NovelError.message("记忆候选格式、数量或来源不正确。") }
+        for fact in delta.updates {
+            guard !fact.subject.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+                  !fact.predicate.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+                  !fact.value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+                  fact.subject.count <= 120, fact.predicate.count <= 120, fact.value.count <= 2000,
+                  !fact.evidence.isEmpty, fact.evidence.count <= 1000,
