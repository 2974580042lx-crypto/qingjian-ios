+@MainActor
+private struct NovelChapterView: View {
+    let projectID: UUID
+    let chapterID: UUID
+    @EnvironmentObject private var app: AppStore
+    @EnvironmentObject private var novels: NovelStore
+    @State private var edit: NovelEditRequest?
+    @State private var candidate: NovelCandidate?
+    @State private var version: NovelRevision?
+    @State private var showConfirm = false
+    @State private var visible = false
+
+    private var generator: NovelTextGenerator {
+        { system, prompt, onText in try await app.generateNovelText(system: system, prompt: prompt, onText: onText) }
+    }
+
+    var body: some View {
+        Group {
+            if let project = novels.project(projectID), let chapter = project.chapters.first(where: { $0.id == chapterID }) {
+                chapterPage(project, chapter)
+            } else { ContentUnavailableView("章节已移除", systemImage: "doc") }
+        }
+        .sheet(item: $edit) { NovelEditorSheet(request: $0).environmentObject(novels) }
+        .sheet(item: $candidate) { NovelCandidateSheet(projectID: projectID, candidateID: $0.id).environmentObject(novels) }
+        .sheet(item: $version) { value in
+            NovelVersionSheet(projectID: projectID, chapterID: chapterID, version: value).environmentObject(novels)
+        }
+        .confirmationDialog("从当前正文提取记忆？", isPresented: $showConfirm, titleVisibility: .visible) {
+            Button("提取本章记忆") {
+                novels.confirmChapter(projectID: projectID, chapterID: chapterID, generator: generator)
+            }
+        } message: { Text("将提取人物状态、知情边界、时间线和伏笔。下一步会先展示结果，确认后才定稿并更新账本。") }
+        .onAppear { visible = true }.onDisappear { visible = false }
+        .novelErrorAlert(novels, enabled: visible && edit == nil && candidate == nil && version == nil)
+    }
+
+    private func chapterPage(_ project: NovelProject, _ chapter: NovelChapter) -> some View {
+        List {
+            Section {
+                HStack {
+                    Text(chapter.needsReview ? "待复核" : chapter.status.title).foregroundStyle(Ink.seal)
+                    Spacer()
+                    Text("\(chapter.wordCount) 字").foregroundStyle(Ink.ink3)
+                }.font(TypeScale.label)
+                if chapter.needsReview {
+                    Text("正文、设定或前文已有变化，请核对后重新定稿。")
+                        .font(TypeScale.caption).foregroundStyle(Ink.ink2)
+                }
+                Button("编辑章名、提纲与正文", systemImage: "pencil") { editChapter(chapter) }
+            }.listRowBackground(Color.clear)
+            Section("本章提纲") { readable(chapter.plan, empty: "先确定本章要发生什么。") }.listRowBackground(Color.clear)
+            Section("正文") { readable(chapter.body, empty: "还没有正文，可以自己写，也可以先生成候选稿。") }.listRowBackground(Color.clear)
+            Section("创作与审阅") {
+                actionButton(.plan, chapter: chapter)
+                actionButton(.draft, chapter: chapter)
+                actionButton(.review, chapter: chapter)
+                actionButton(.polish, chapter: chapter)
+                Button("提取本章记忆，准备定稿", systemImage: "checkmark.seal") { showConfirm = true }
+                    .disabled(novels.isGenerating || chapter.body.isEmpty || (chapter.status == .confirmed && !chapter.needsReview))
+            }.listRowBackground(Color.clear)
+            if chapter.memoryCandidate != nil {
+                Section {
+                    NavigationLink {
+                        NovelMemoryCandidateView(projectID: projectID, chapterID: chapterID)
+                    } label: {
+                        VStack(alignment: .leading, spacing: 7) {
+                            Label("审阅记忆并确认定稿", systemImage: "checkmark.seal")
+                                .font(TypeScale.subject).foregroundStyle(Ink.seal)
+                            Text("先核对提取出的事实、人物知情和伏笔变化。")
+                                .font(TypeScale.caption).foregroundStyle(Ink.ink2)
+                        }
+                    }
+                }.listRowBackground(Ink.raised)
+            }
+            if novels.running?.projectID == projectID {
+                Section {
+                    HStack {
+                        ProgressView()
+                        Text(novels.running?.title ?? "正在生成").font(TypeScale.body)
+                        Spacer()
+                        Button("暂停") { novels.stop() }
+                    }
+                }.listRowBackground(Ink.raised)
+            } else if let run = project.lastRun, run.chapterID == chapterID, run.status == .paused || run.status == .failed {
+                Section {
+                    Text(run.detail).font(TypeScale.caption).foregroundStyle(Ink.ink2)
+                    Button("继续上次任务") { novels.resume(projectID: projectID, generator: generator) }.disabled(novels.isGenerating)
+                }.listRowBackground(Color.clear)
+            }
+            let candidates = project.candidates.filter { $0.chapterID == chapterID }
+            if !candidates.isEmpty {
+                Section("候选与半稿") {
+                    ForEach(candidates) { value in
+                        Button { candidate = value } label: {
+                            VStack(alignment: .leading, spacing: 6) {
+                                Text(value.action.title + (value.isComplete ? " · 查看并采纳" : " · 未完成"))
+                                    .font(TypeScale.body).foregroundStyle(Ink.seal)
+                                Text(value.text.isEmpty ? "等待模型返回…" : value.text)
+                                    .font(TypeScale.caption).foregroundStyle(Ink.ink2).lineLimit(3)
+                            }
+                        }
+                    }
+                }.listRowBackground(Color.clear)
+            }
+            if !chapter.review.isEmpty {
+                Section("审阅意见") { readable(chapter.review) }.listRowBackground(Color.clear)
+            }
+            Section {
+                if chapter.summary.isEmpty {
+                    Text("定稿后，这里会留下后续写作使用的记忆。")
+                        .font(TypeScale.body).foregroundStyle(Ink.ink3)
+                } else {
+                    memoryBlock("前情摘要", text: chapter.summary)
+                    memoryBlock("人物状态与已知信息", text: chapter.characterState)
+                    memoryBlock("伏笔与未决问题", text: chapter.foreshadowing)
+                    if chapter.status == .confirmed {
+                        Button("编辑本章摘要", systemImage: "pencil") { editMemory(chapter) }.disabled(novels.isGenerating)
+                    }
+                }
+                NavigationLink("查看与纠正事实账本") { NovelLedgerView(projectID: projectID) }
+            } header: { Text("定稿摘要") }
+              footer: { Text("摘要便于回看。人物、知情边界和伏笔等正式事实请在记忆账本中纠正。") }
+              .listRowBackground(Color.clear)
+            if !chapter.versions.isEmpty {
+                Section("保留的旧稿") {
+                    ForEach(chapter.versions.reversed()) { value in
+                        Button { version = value } label: {
+                            VStack(alignment: .leading, spacing: 5) {
+                                Text(value.label).font(TypeScale.body)
+                                Text(value.createdAt, style: .date).font(TypeScale.caption).foregroundStyle(Ink.ink3)
+                            }
+                        }
+                    }
+                }.listRowBackground(Color.clear)
+            }
+        }
+        .listStyle(.insetGrouped).scrollContentBackground(.hidden).background(AppBackground())
+        .navigationTitle(chapter.title).navigationBarTitleDisplayMode(.inline)
+    }
+
+    private func readable(_ text: String, empty: String = "尚无内容") -> some View {
+        Text(text.isEmpty ? empty : text).font(TypeScale.answer).foregroundStyle(text.isEmpty ? Ink.ink3 : Ink.ink)
+            .lineSpacing(7).textSelection(.enabled).padding(.vertical, 5)
+    }
+
+    private func memoryBlock(_ title: String, text: String) -> some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Text(title).font(TypeScale.label).foregroundStyle(Ink.seal)
+            readable(text, empty: "无")
+        }
+    }
+
+    private func actionButton(_ action: NovelAction, chapter: NovelChapter) -> some View {
+        Button(action.title, systemImage: action == .review ? "checkmark.bubble" : "sparkles") {
+            novels.generate(projectID: projectID, chapterID: chapterID, action: action, generator: generator)
+        }
+        .disabled(novels.isGenerating || ((action == .review || action == .polish) && chapter.body.isEmpty))
+    }
+
+    private func editChapter(_ chapter: NovelChapter) {
+        edit = NovelEditRequest(title: "编辑章节", fields: [
+            NovelEditField(title: "章名", text: chapter.title, multiline: false),
+            NovelEditField(title: "本章提纲", text: chapter.plan),
+            NovelEditField(title: "正文", text: chapter.body),
+            NovelEditField(title: "审阅意见 / 改写要求", text: chapter.review)
+        ], note: "手动保存后生效。正文改动前的版本会保留。") { values in
+            var copy = chapter
+            copy.title = values[0]; copy.plan = values[1]; copy.body = values[2]; copy.review = values[3]
+            return novels.updateChapter(projectID: projectID, chapter: copy)
+        }
+    }
+
+    private func editMemory(_ chapter: NovelChapter) {
+        edit = NovelEditRequest(title: "编辑本章摘要", fields: [
+            NovelEditField(title: "前情摘要", text: chapter.summary),
+            NovelEditField(title: "人物状态与已知信息", text: chapter.characterState),
+            NovelEditField(title: "伏笔与未决问题", text: chapter.foreshadowing)
+        ], note: "摘要供回看和补充上下文，不会改写事实账本。正式事实纠错请使用‘查看与纠正事实账本’。") { values in
+            novels.updateChapterMemory(projectID: projectID, chapterID: chapterID, summary: values[0],
+                characterState: values[1], foreshadowing: values[2], expectedRevision: chapter.revision)
+        }
+    }
+}
