+    """
+
+    static func memory(_ text: String, chapter: NovelChapter, chapterIndex: Int,
+                       ledger: NovelCanonSnapshot) throws -> NovelMemoryDelta {
+        let value: MemoryExtraction = try JSONExtraction.decode(text)
+        guard !value.summary.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              value.summary.count <= 6000, value.characterState.count <= 6000, value.foreshadowing.count <= 6000,
+              value.updates.count <= 80, value.resolveIDs.count <= 80, value.expireIDs.count <= 80,
