+            let predicate = item.predicate.trimmingCharacters(in: .whitespacesAndNewlines)
+            let factValue = item.value.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !subject.isEmpty, subject.count <= 120, !predicate.isEmpty, predicate.count <= 120,
+                  !factValue.isEmpty, factValue.count <= 2000 else {
+                throw NovelError.message("记忆条目的对象、属性或内容不正确，请重新提取。")
+            }
+            if ledger.activeFacts.contains(where: {
