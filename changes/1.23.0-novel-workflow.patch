+import SwiftUI
+import UniformTypeIdentifiers
+
+@MainActor
+struct NovelLibraryView: View {
+    @EnvironmentObject private var app: AppStore
+    @EnvironmentObject private var novels: NovelStore
+    @Environment(\.dismiss) private var dismiss
+    @State private var path: [UUID] = []
+    @State private var edit: NovelEditRequest?
+    @State private var deleteTarget: NovelProject?
+    @State private var search = ""
+
+    private var visible: [NovelProject] {
+        novels.projects.filter { search.isEmpty || $0.title.localizedCaseInsensitiveContains(search) }
+            .sorted { $0.updatedAt > $1.updatedAt }
+    }
+
+    var body: some View {
+        NavigationStack(path: $path) {
+            List {
+                Section {
+                    VStack(alignment: .leading, spacing: 10) {
+                        Text("让故事记得已经发生的事。")
+                            .font(TypeScale.subject).foregroundStyle(Ink.ink)
+                        Text("人物状态、谁知道什么、时间线与伏笔，随已确认的章节积累。逐章创作，也可以连续起草后再审阅。")
+                            .font(TypeScale.body).foregroundStyle(Ink.ink2).lineSpacing(5)
+                        Button("开始一本新书", systemImage: "plus") { newProject() }
+                            .font(TypeScale.body).tint(Ink.seal)
+                    }.padding(.vertical, 10)
+                }.listRowBackground(Color.clear)
+                if let run = novels.running {
+                    Section {
+                        Button { path.append(run.projectID) } label: {
+                            HStack {
+                                ProgressView()
+                                VStack(alignment: .leading, spacing: 4) {
+                                    Text(run.title).font(TypeScale.body)
+                                    Text(run.detail).font(TypeScale.caption).foregroundStyle(Ink.ink2)
+                                }
+                            }
+                        }
+                    }.listRowBackground(Ink.raised)
+                }
+                Section("我的作品") {
+                    if visible.isEmpty {
+                        Text(search.isEmpty ? "从一句创意开始，人物、设定和章节都会留在这里。" : "没有找到这部作品")
+                            .font(TypeScale.body).foregroundStyle(Ink.ink3).padding(.vertical, 12)
+                            .listRowBackground(Color.clear)
+                    }
+                    ForEach(visible) { project in
+                        NavigationLink(value: project.id) {
+                            VStack(alignment: .leading, spacing: 8) {
+                                Text(project.title).font(TypeScale.subject).foregroundStyle(Ink.ink)
+                                if !project.brief.isEmpty {
+                                    Text(project.brief).font(TypeScale.label).foregroundStyle(Ink.ink2).lineLimit(2)
+                                }
+                                Text("\(project.chapters.count) 章 · \(project.confirmedCount) 章定稿 · \(project.wordCount) 字")
+                                    .font(TypeScale.caption).foregroundStyle(Ink.ink3)
+                            }.padding(.vertical, 8)
+                        }
