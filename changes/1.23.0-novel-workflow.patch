+import SwiftUI
+import UIKit
+
+@MainActor
+struct NovelWorkspaceView: View {
+    let projectID: UUID
+    @EnvironmentObject private var app: AppStore
+    @EnvironmentObject private var novels: NovelStore
+    @State private var edit: NovelEditRequest?
+    @State private var candidate: NovelCandidate?
+    @State private var shareURL: URL?
+    @State private var batchCount = 2
+    @State private var showBatch = false
+    @State private var published = false
+    @State private var publishing = false
+    @State private var visible = false
+
+    private var generator: NovelTextGenerator {
+        { system, prompt, onText in try await app.generateNovelText(system: system, prompt: prompt, onText: onText) }
+    }
+
+    var body: some View {
+        Group {
+            if let project = novels.project(projectID) { workspace(project) }
+            else { ContentUnavailableView("作品已移除", systemImage: "doc") }
+        }
+        .sheet(item: $edit) { NovelEditorSheet(request: $0).environmentObject(novels) }
+        .sheet(item: $candidate) { NovelCandidateSheet(projectID: projectID, candidateID: $0.id).environmentObject(novels) }
+        .sheet(isPresented: Binding(get: { shareURL != nil }, set: { if !$0 { shareURL = nil } })) {
+            if let shareURL { ShareSheet(items: [shareURL]) }
+        }
+        .sheet(isPresented: $showBatch) { batchSheet }
+        .alert("已放到书架", isPresented: $published) {
+            Button("好", role: .cancel) { }
+        } message: { Text("已将可用定稿另存为一本书。回到侧栏的书架即可阅读。") }
+        .onAppear { visible = true }.onDisappear { visible = false }
+        .novelErrorAlert(novels, enabled: visible && edit == nil && candidate == nil && shareURL == nil && !showBatch)
+    }
+
+    private func workspace(_ project: NovelProject) -> some View {
+        List {
+            Section {
+                Text("每章按需读取人物状态、知情边界、时间线与伏笔。正文确认后，先检查提取的记忆，再定稿写入账本。")
+                    .font(TypeScale.body).foregroundStyle(Ink.ink2).lineSpacing(5)
+                Text("默认逐章确认。模型仍可能记错，记忆可以随时查看和纠正。")
+                    .font(TypeScale.caption).foregroundStyle(Ink.ink3)
+            }.listRowBackground(Color.clear)
+            Section {
+                NavigationLink {
+                    NovelLedgerView(projectID: projectID)
+                } label: {
+                    Label("小说记忆账本", systemImage: "list.bullet.rectangle.portrait")
+                        .font(TypeScale.subject)
+                }
+                Text("查看每条事实的来源章节，纠正误记，也能固定你确认的重要设定。")
+                    .font(TypeScale.caption).foregroundStyle(Ink.ink2)
+            }.listRowBackground(Color.clear)
+            if let run = novels.running?.projectID == projectID ? novels.running : project.lastRun {
+                Section {
+                    VStack(alignment: .leading, spacing: 10) {
+                        HStack {
+                            if run.status == .running { ProgressView() }
+                            Text(run.title).font(TypeScale.body)
+                            Spacer()
+                            if run.status == .running {
+                                Button("暂停") { novels.stop() }
+                            } else if run.status == .paused || run.status == .failed {
+                                Button("继续") { novels.resume(projectID: projectID, generator: generator) }
+                                    .disabled(novels.isGenerating)
+                            }
+                        }
+                        Text(run.detail).font(TypeScale.caption).foregroundStyle(Ink.ink2)
+                        if run.status == .running {
+                            Text("请保持应用在前台，退到后台会暂停并保留进度。")
+                                .font(TypeScale.caption).foregroundStyle(Ink.ink3)
+                        }
+                    }.padding(.vertical, 4)
+                }.listRowBackground(Ink.raised)
+            }
+            if novels.saveRecoveryAvailable {
+                Section {
+                    Button("重试保存进度", systemImage: "arrow.clockwise") { _ = novels.retrySave() }
+                    Text("也可以先从右上角导出备份，保留当前内容。")
+                        .font(TypeScale.caption).foregroundStyle(Ink.ink2)
+                }
+            }
+            Section("全书依据") {
+                referenceRow("创作简报", text: project.brief) { editProject(project, field: "brief") }
+                referenceRow("世界设定", text: project.world, action: .world) { editProject(project, field: "world") }
+                referenceRow("人物档案", text: project.characters, action: .characters) { editProject(project, field: "characters") }
+                referenceRow("全书大纲", text: project.outline, action: .outline) { editProject(project, field: "outline") }
+            }.listRowBackground(Color.clear)
+            let setupCandidates = project.candidates.filter { $0.chapterID == nil }
+            if !setupCandidates.isEmpty {
+                Section("资料候选") {
+                    ForEach(setupCandidates) { candidateRow($0) }
+                }.listRowBackground(Color.clear)
+            }
+            Section {
+                ForEach(project.chapters) { chapter in
+                    NavigationLink {
+                        NovelChapterView(projectID: projectID, chapterID: chapter.id)
+                    } label: {
+                        VStack(alignment: .leading, spacing: 7) {
+                            Text(chapter.title).font(TypeScale.subject).foregroundStyle(Ink.ink)
+                            HStack(spacing: 10) {
+                                Text(chapter.needsReview ? "待复核" : chapter.status.title)
+                                Text("\(chapter.wordCount) 字")
+                                let count = project.candidates.filter { $0.chapterID == chapter.id }.count
+                                if count > 0 { Text("\(count) 份候选") }
+                            }.font(TypeScale.caption).foregroundStyle(Ink.ink3)
+                        }.padding(.vertical, 5)
+                    }
+                }
+                Button("添加一章", systemImage: "plus") { _ = novels.addChapter(projectID: projectID) }
+                    .disabled(novels.isGenerating)
+                Button("连续起草…", systemImage: "text.badge.plus") { showBatch = true }
+                    .disabled(novels.isGenerating)
+            } header: {
+                Text("章节 · \(project.confirmedCount)/\(project.chapters.count) 章定稿")
+            } footer: {
+                Text("修改前文或设定后，受影响章节会标为待复核，重新确认后再作为后文记忆。")
+            }.listRowBackground(Color.clear)
+        }
+        .listStyle(.insetGrouped).scrollContentBackground(.hidden).background(AppBackground())
+        .navigationTitle(project.title).navigationBarTitleDisplayMode(.inline)
+        .toolbar {
+            ToolbarItem(placement: .topBarTrailing) {
+                Menu {
+                    Button("修改书名", systemImage: "pencil") { editProject(project, field: "title") }
+                    Button("正文与候选 · TXT", systemImage: "doc.text") { shareURL = novels.exportText(projectID: projectID, markdown: false) }
+                    Button("正文与候选 · Markdown", systemImage: "doc.richtext") { shareURL = novels.exportText(projectID: projectID, markdown: true) }
+                    Button("完整备份 · JSON", systemImage: "externaldrive") { shareURL = novels.exportBackup(projectID: projectID) }
+                    Button("把定稿放到书架", systemImage: "books.vertical") { publish(project) }
+                        .disabled(project.confirmedCount == 0 || publishing)
+                } label: { Image(systemName: "ellipsis.circle") }.accessibilityLabel("作品操作与导出")
+            }
+        }
+    }
+
+    private func referenceRow(_ title: String, text: String, action: NovelAction? = nil, edit: @escaping () -> Void) -> some View {
+        VStack(alignment: .leading, spacing: 8) {
+            HStack {
+                Text(title).font(TypeScale.subject)
+                Spacer()
+                Button("编辑", action: edit).font(TypeScale.label)
+            }
+            Text(text.isEmpty ? "尚未填写" : text).font(TypeScale.body).foregroundStyle(text.isEmpty ? Ink.ink3 : Ink.ink2)
+                .lineLimit(3).lineSpacing(4)
+            if let action {
+                Button(action.title, systemImage: "sparkles") {
+                    novels.generate(projectID: projectID, action: action, generator: generator)
+                }.font(TypeScale.label).tint(Ink.seal).disabled(novels.isGenerating)
+            }
+        }.padding(.vertical, 5)
+    }
+
+    private func candidateRow(_ value: NovelCandidate) -> some View {
+        Button { candidate = value } label: {
+            VStack(alignment: .leading, spacing: 5) {
+                Text(value.action.title + (value.isComplete ? " · 待采纳" : " · 未完成"))
+                    .font(TypeScale.body).foregroundStyle(Ink.seal)
+                Text(value.text.isEmpty ? "等待模型返回…" : value.text)
+                    .font(TypeScale.caption).foregroundStyle(Ink.ink2).lineLimit(2)
+            }
+        }
+    }
+
+    private func editProject(_ project: NovelProject, field: String) {
+        let titles = ["title": "书名", "brief": "创作简报", "world": "世界设定", "characters": "人物档案", "outline": "全书大纲"]
+        let values = ["title": project.title, "brief": project.brief, "world": project.world, "characters": project.characters, "outline": project.outline]
+        let label = titles[field] ?? "资料"
+        edit = NovelEditRequest(title: label, fields: [NovelEditField(title: label, text: values[field] ?? "", multiline: field != "title")],
+            note: project.chapters.isEmpty ? "" : "保存修改后，已有定稿会标为待复核。") { values in
+            var copy = project
+            switch field {
+            case "title": copy.title = values[0]
+            case "brief": copy.brief = values[0]
+            case "world": copy.world = values[0]
+            case "characters": copy.characters = values[0]
+            default: copy.outline = values[0]
+            }
+            return novels.update(copy)
+        }
+    }
+
+    private var batchSheet: some View {
+        NavigationStack {
+            Form {
+                Section {
+                    Stepper("新增 \(batchCount) 章", value: $batchCount, in: 1...5)
+                    Text("从现有章节末尾新增并连续起草。所有结果先存为候选，需要你逐章采纳、审阅和定稿；不会填入已有的空章。")
+                        .font(TypeScale.body).foregroundStyle(Ink.ink2).lineSpacing(5)
+                    Text("每章会调用模型，费用沿用当前模型的计费。请保持应用在前台，可随时暂停。")
+                        .font(TypeScale.caption).foregroundStyle(Ink.ink3)
+                }
+                Button("开始连续起草") {
+                    showBatch = false
+                    novels.draftBatch(projectID: projectID, count: batchCount, generator: generator)
+                }.disabled(novels.isGenerating)
+            }
+            .scrollContentBackground(.hidden).background(AppBackground())
+            .navigationTitle("连续起草").navigationBarTitleDisplayMode(.inline)
+            .toolbar { ToolbarItem(placement: .cancellationAction) { Button("取消") { showBatch = false } } }
+        }.presentationDetents([.medium, .large])
+    }
+
+    private func publish(_ project: NovelProject) {
+        let chapters = project.chapters.filter { $0.status == .confirmed && !$0.needsReview }
+        let text = chapters.map { $0.title + "\n\n" + $0.body }.joined(separator: "\n\n")
+        publishing = true
+        Task {
+            let id = await app.books.publishNovel(title: project.title, text: text)
+            publishing = false
+            if id != nil { published = true }
+            else { novels.errorMessage = app.books.errorMessage ?? "未能保存到书架，请稍后重试。" }
+        }
+    }
+}
