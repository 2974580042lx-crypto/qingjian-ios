+@MainActor
+private struct NovelCandidateSheet: View {
+    let projectID: UUID
+    let candidateID: UUID
+    @EnvironmentObject private var novels: NovelStore
+    @Environment(\.dismiss) private var dismiss
+    @State private var discard = false
+    @State private var copied = false
+
+    var body: some View {
+        NavigationStack {
+            if let project = novels.project(projectID), let value = project.candidates.first(where: { $0.id == candidateID }) {
+                let stale = value.sourceRevision != project.revision || !NovelWorkflow.dependenciesMatch(value, project: project) ||
+                    (value.chapterID != nil && value.chapterRevision != project.chapters.first(where: { $0.id == value.chapterID })?.revision)
+                ScrollView {
+                    VStack(alignment: .leading, spacing: 18) {
+                        if value.action == .confirm {
+                            Text("这是记忆提取的原始记录。提取成功后，回到章节审阅结构化记忆，再确认定稿。")
+                                .font(TypeScale.label).foregroundStyle(Ink.ink2)
+                        } else if !value.isComplete {
+                            Text("这份内容尚未完整返回，已收到的文字会保留。")
+                                .font(TypeScale.label).foregroundStyle(Ink.ink2)
+                        } else if stale {
+                            Text("生成后，依据或正文已有变化。这份候选已过期，可复制所需内容，核对后手动合入。")
+                                .font(TypeScale.label).foregroundStyle(Ink.seal)
+                        } else {
+                            Text("采纳后才会写入当前资料或手稿；正文仍需另行确认定稿。")
+                                .font(TypeScale.label).foregroundStyle(Ink.ink2)
+                        }
+                        Text(value.text.isEmpty ? "等待模型返回…" : value.text)
+                            .font(TypeScale.answer).foregroundStyle(Ink.ink).lineSpacing(7).textSelection(.enabled)
+                        if let memory = value.memoryDescription, !memory.isEmpty {
+                            DisclosureGroup("本次使用的记忆") {
+                                Text(memory).font(TypeScale.label).foregroundStyle(Ink.ink2)
+                                    .lineSpacing(4).textSelection(.enabled).padding(.top, 8)
+                            }.font(TypeScale.body)
+                        }
+                    }.frame(maxWidth: .infinity, alignment: .leading).padding(22)
+                }.background(AppBackground())
+                .navigationTitle(value.action.title).navigationBarTitleDisplayMode(.inline)
+                .toolbar {
+                    ToolbarItem(placement: .cancellationAction) { Button("关闭") { dismiss() } }
+                    ToolbarItem(placement: .confirmationAction) {
+                        Button("采纳") {
+                            if novels.acceptCandidate(projectID: projectID, candidateID: candidateID) { dismiss() }
+                        }.disabled(!value.isComplete || stale || novels.isGenerating || value.action == .confirm)
+                    }
+                    ToolbarItemGroup(placement: .bottomBar) {
+                        Button(copied ? "已复制" : "复制全文", systemImage: "doc.on.doc") {
+                            UIPasteboard.general.string = value.text; copied = true
+                        }
+                        Spacer()
+                        Button("移除候选", systemImage: "trash", role: .destructive) { discard = true }
+                            .disabled(novels.running?.candidateID == candidateID)
+                    }
+                }
+                .confirmationDialog("移除这份候选？", isPresented: $discard, titleVisibility: .visible) {
+                    Button("移除", role: .destructive) {
+                        if novels.discardCandidate(projectID: projectID, candidateID: candidateID) { dismiss() }
+                    }
+                }
+            } else { ContentUnavailableView("候选已处理", systemImage: "checkmark") }
+        }.tint(Ink.ink).novelErrorAlert(novels)
+    }
+}
