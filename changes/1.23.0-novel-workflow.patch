+            removalEvidence[item.id] = item.evidence
+        }
+        let delta = NovelMemoryDelta(id: UUID(), sourceChapterID: chapter.id, sourceBodyFingerprint: bodyFingerprint,
+            baseLedgerFingerprint: ledger.fingerprint, summary: value.summary, characterState: value.characterState,
+            foreshadowing: value.foreshadowing, updates: updates, resolveIDs: value.resolveIDs,
+            expireIDs: value.expireIDs, removalEvidence: removalEvidence, createdAt: Date())
+        try NovelMemory.validate(delta: delta, chapter: chapter, ledger: ledger)
+        return delta
+    }
+
+    private static func validateEvidence(_ evidence: String, body: String) throws {
+        guard evidence.count >= 10, evidence.count <= 300, body.contains(evidence) else {
+            throw NovelError.message("有一条记忆证据不能在本章原文中逐字找到，或不在10至300字范围内。正文未改动，请重新提取或手动核对。")
+        }
+    }
+
+    private static func describe(_ fact: NovelFact, project: NovelProject) -> String {
+        let source = project.chapters.first { $0.id == fact.sourceChapterID }?.title ?? "来源章节不可用"
+        let authority = fact.locked ? "作者锁定" : fact.origin == .user ? "作者更正" : "正文提取"
+        let correction = fact.origin == .user ? "\n作者更正说明：" + (fact.correctionNote ?? "作者已手动核对；原句仅保留作来源回看。") : ""
+        return "[\(fact.id.uuidString)] \(fact.kind.rawValue) | \(fact.subject) | \(fact.predicate) = \(fact.value)\n来源：\(source)；第\(fact.validFromChapter)章起有效；正文版本\(fact.sourceBodyFingerprint.prefix(12))；\(authority)\n原始证据：\(fact.evidence)" + correction
+    }
+
+    static func export(_ project: NovelProject, markdown: Bool) -> String {
+        var pieces = [(markdown ? "# " : "") + project.title]
+        for chapter in project.chapters {
+            let status = chapter.needsReview ? "待复核" : chapter.status.title
+            pieces.append((markdown ? "## " : "") + chapter.title + "（\(status)）\n\n" + chapter.body)
+            let candidates = project.candidates.filter { $0.chapterID == chapter.id && [.draft, .polish].contains($0.action) && !$0.text.isEmpty }
+            for candidate in candidates {
+                let stale = candidate.sourceRevision != project.revision || candidate.chapterRevision != chapter.revision || !dependenciesMatch(candidate, project: project)
+                let state = !candidate.isComplete ? "中断半稿" : stale ? "过期候选，需核对" : "未采纳候选"
+                pieces.append((markdown ? "### " : "") + chapter.title + " · " + candidate.action.title + "（\(state)）\n\n" + candidate.text)
+            }
+        }
+        return pieces.joined(separator: "\n\n") + "\n"
+    }
+}
