+        marks[markIndex].note = clean.isEmpty ? nil : clean
+        var updated = original
+        updated.readerMarks = marks
+        guard save(updated) else {
+            if let bookIndex = books.firstIndex(where: { $0.id == id }) { books[bookIndex] = original }
