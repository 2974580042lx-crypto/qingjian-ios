+/// Sermo's thinking mark: five small terracotta petals round a seed. While it thinks
+/// the flower turns slowly and the petals breathe one after another; when it is done
+/// they settle into a still little flower. Motion stops when Reduce Motion is on.
+///
+/// The motion is handed to the system's animation engine once (repeating rotation and
+/// scale), so the view is not redrawn frame by frame: an earlier version recomputed
+/// the flower on every display frame and kept the phone warm through long answers.
+struct ThinkingMark: View {
+    var live: Bool
+    var size: CGFloat = 18
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var moving = false
+    private var animated: Bool { live && !reduceMotion }
+
+    var body: some View {
+        let dot = size * 0.26
+        let ring = size * 0.34
+        ZStack {
+            ForEach(0..<5, id: \.self) { index in
+                Circle().fill(Ink.seal)
+                    .frame(width: dot, height: dot)
+                    .scaleEffect(animated && moving ? 0.72 : 1)
+                    .opacity(animated && moving ? 0.6 : 0.9)
+                    .animation(animated
+                               ? .easeInOut(duration: 0.9).repeatForever(autoreverses: true).delay(Double(index) * 0.18)
+                               : .easeOut(duration: 0.3), value: moving)
+                    .offset(y: -ring)
+                    .rotationEffect(.degrees(Double(index) * 72))
+            }
+            Circle().fill(Ink.seal).frame(width: dot * 0.7, height: dot * 0.7)
+        }
+        .rotationEffect(.degrees(animated && moving ? 360 : 0))
+        .animation(animated ? .linear(duration: 5.2).repeatForever(autoreverses: false) : .easeOut(duration: 0.3), value: moving)
+        .frame(width: size, height: size)
+        .onAppear { if animated { moving = true } }
+        .onChange(of: animated) { _, now in moving = now }
+        .accessibilityHidden(true)
+    }
+}
