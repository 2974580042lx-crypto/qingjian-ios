+/// Sermo's thinking mark: five small terracotta petals round a seed. While it thinks
+/// the petals turn slowly and breathe one after another; when it is done they settle
+/// into a still little flower. Motion stops when Reduce Motion is on.
+struct ThinkingMark: View {
+    var live: Bool
+    var size: CGFloat = 18
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    var body: some View {
+        Group {
+            if live && !reduceMotion {
+                TimelineView(.animation) { timeline in
+                    petals(time: timeline.date.timeIntervalSinceReferenceDate)
+                }
+            } else {
+                petals(time: nil)
+            }
+        }
+        .frame(width: size, height: size)
+        .accessibilityHidden(true)
+    }
+
+    private func petals(time: Double?) -> some View {
+        let dot = size * 0.26
+        let ring = size * 0.34
+        let turn = (time ?? 0) * 70
+        return ZStack {
+            ForEach(0..<5, id: \.self) { index in
+                let wave = time.map { 0.72 + 0.28 * (0.5 + 0.5 * sin($0 * 3.2 - Double(index) * 1.25)) } ?? 1
+                Circle().fill(Ink.seal)
+                    .frame(width: dot * wave, height: dot * wave)
+                    .opacity(time == nil ? 0.9 : 0.55 + 0.45 * wave)
+                    .offset(y: -ring)
+                    .rotationEffect(.degrees(Double(index) * 72 + turn))
+            }
+            Circle().fill(Ink.seal).frame(width: dot * 0.7, height: dot * 0.7)
+        }
+    }
+}
 
